model Enrollment{
  id Int @id @default(autoincrement())
  progress Int
  completed Boolean

  userId Int
  user User @relation(fields: [userId], references: [id])

  courseId Int
  course Course @relation(fields: [courseId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Status {
  EXCELLENT
  GOOD
  MEDIUM
  BAD
}

model Review{
  id Int @id @default(autoincrement())
  stars Int
  description String
  images String[]
  color Status @default(EXCELLENT)
  
  userId Int //foregin key
  user User @relation(fields: [userId],references: [id])
  
  courseId Int //foreign key 
  course Course @relation(fields: [courseId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Lesson{
  id Int @id @default(autoincrement())
  name String
  description String
  sequence Int @default(autoincrement())  
  duration DateTime



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Type {
  VIDEO
  PDF
  QUIZ
  PRACTICAL
}

model content{
  id Int @id @default(autoincrement())
  type Type @default(VIDEO)
  upVotes Int @default(autoincrement())
  views Int
  duration   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


